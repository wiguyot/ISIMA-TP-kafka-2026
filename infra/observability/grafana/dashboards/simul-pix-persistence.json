          "query": "from(bucket: \"simulpix_observability\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"postgres_runtime\")\n  |> filter(fn: (r) => r._field == \"validated_count\" or r._field == \"rejected_count\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> derivative(unit: 1s, nonNegative: true)\n  |> yield(name: \"rate\")",
