      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "simulpix-influxdb"
          },
          "query": "from(bucket: \"simulpix_observability\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"simulpix_platform\")\n  |> filter(fn: (r) => r._field == \"generated\" or r._field == \"processed\" or r._field == \"validated\" or r._field == \"rejected\" or r._field == \"outcome_count\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> yield(name: \"last\")",
